# Template: copy this file to .env before starting the Docker deployment.
SERVER_PORT=8090
IR_AUTH_SECRET=
IR_TOKEN_TTL=12h
IR_ADMIN_PASSWORD=admin123
IR_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
IR_SYNC_ENABLED=true
IR_ALLOW_PRIVATE_HOSTS=false
IR_COST_HANDLING_PER_ORDER=1.5
IR_COST_PACKAGING_PER_ORDER=0.8
IR_SANDBOX_AUTO_CRON=0 30 */6 * * ?
IR_SANDBOX_AUTO_ON_STARTUP=true
IR_SANDBOX_AUTO_ENABLED=true
IR_SANDBOX_AUTO_APPLY=false
IR_SANDBOX_AUTO_QUEUE=true
IR_SANDBOX_COST_WEIGHT=0.5
IR_SANDBOX_EFFICIENCY_WEIGHT=0.5
IR_SANDBOX_SAFETY_DAYS=3
IR_SANDBOX_REPLENISH_LEAD_DAYS=3
IR_HTTP_SYSTEMS=
IR_BALANCE_MODE=AUTO
IR_BALANCE_SCHEDULE=true
IR_BALANCE_CRON=0 10/30 * * * ?
IR_BALANCE_MAX_DECISIONS=20
IR_BALANCE_MAX_AUTO=10
IR_BALANCE_PURCHASE_LIMIT=20000
IR_BALANCE_COOLDOWN_HOURS=24
IR_BALANCE_SERVICE_GUARD=0.9
VITE_API_BASE=/api
